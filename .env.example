# Copy to .env.local and fill from the Firebase console (Project settings > Your apps).
# Firebase web config values are public identifiers. Never place private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA Enterprise site key. AI Logic and family sharing need App Check.
VITE_APPCHECK_SITE_KEY=

# Local development only. Enables the App Check debug token; never true in production.
VITE_APPCHECK_DEBUG=false

# Cloud fallback model. Leave unset to use the SDK default (gemini-3.5-flash-lite).
VITE_CLOUD_MODEL=
